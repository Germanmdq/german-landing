# Mercado Pago Checkout Pro (pago único). Configurar moneda e importes
# explícitamente; la aplicación no hace conversiones de moneda implícitas.
MERCADOPAGO_ACCESS_TOKEN=your_access_token
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret
MERCADOPAGO_CURRENCY=ARS
MERCADOPAGO_AMOUNT_30_DAYS=your_amount
MERCADOPAGO_AMOUNT_ANNUAL=your_amount
MERCADOPAGO_AMOUNT_LIFETIME=your_amount

# PayPal Orders v2 (pago único)
PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id
